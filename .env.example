# Notion integration for the contractors waitlist form (POST /api/waitlist)
# Copy this file to .env.local for local development.
# 1. Create an integration at https://www.notion.so/my-integrations and grab the secret.
# 2. Share the "Waitlist Contractors" database with that integration.
# 3. Copy the database ID from its URL (the 32-char hex segment).
# Note: this route needs a Next server deployment, such as Cloud Run.
NOTION_TOKEN=
NOTION_WAITLIST_DATABASE_ID=11875da933e749569664a2c248e3379c
